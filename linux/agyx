#!/usr/bin/env bash
# ==============================================================================
# agyx - Antigravity Account-Isolated Runner for WSL & Linux
# Guarantees 100% credential isolation by explicitly setting GEMINI_HOME,
# syncing active keyring tokens per account context, and capturing new session tokens.
# ==============================================================================
set -euo pipefail

export PATH="$HOME/.dotnet:$HOME/.dotnet/tools:$HOME/.local/bin:/usr/local/bin:$PATH"

# Find agy executable
AGY_BIN="$(which agy 2>/dev/null || which antigravity 2>/dev/null || echo "")"
if [ -z "$AGY_BIN" ] || [ "$AGY_BIN" = "$HOME/.local/bin/agyx" ]; then
    if [ -f "$HOME/.local/bin/agy" ] && [ "$HOME/.local/bin/agy" != "$HOME/.local/bin/agyx" ]; then
        AGY_BIN="$HOME/.local/bin/agy"
    elif [ -f "/usr/local/bin/agy" ]; then
        AGY_BIN="/usr/local/bin/agy"
    elif [ -f "$HOME/.gemini/antigravity-cli/agy" ]; then
        AGY_BIN="$HOME/.gemini/antigravity-cli/agy"
    fi
fi

if [ -z "$AGY_BIN" ]; then
    echo -e "\033[31m[agyx ERROR]\033[0m Could not find 'agy' executable on PATH or installation paths." >&2
    exit 1
fi

ARG1="${1:-}"

KNOWN_ACCOUNTS=("fptvttnhon2020" "fptvttnhon2026" "nhontruongvo" "nhontruongvo3" "vothuongtruongnhon2002" "default" "acc1")

IS_ACCOUNT=0
for acc in "${KNOWN_ACCOUNTS[@]}"; do
    if [ "$ARG1" = "$acc" ]; then
        IS_ACCOUNT=1
        break
    fi
done

if [ "$IS_ACCOUNT" -eq 1 ] || [ -d "$HOME/.gemini_$ARG1" ]; then
    TARGET_ACC="$ARG1"
    shift
    if [ "$TARGET_ACC" = "default" ]; then
        export GEMINI_HOME="$HOME/.gemini"
    else
        export GEMINI_HOME="$HOME/.gemini_$TARGET_ACC"
    fi
else
    ACTIVE_ACC=""
    if [ -f "$HOME/.gemini/active_account.txt" ]; then
        ACTIVE_ACC="$(cat "$HOME/.gemini/active_account.txt" | tr -d '\r\n ')"
    fi
    if [ -n "$ACTIVE_ACC" ] && [ "$ACTIVE_ACC" != "default" ]; then
        export GEMINI_HOME="$HOME/.gemini_$ACTIVE_ACC"
        TARGET_ACC="$ACTIVE_ACC"
    else
        export GEMINI_HOME="$HOME/.gemini"
        TARGET_ACC="default"
    fi
fi

mkdir -p "$GEMINI_HOME/antigravity-cli"

# Filter out legacy "auth" / "login" arguments
CLEAN_ARGS=()
for arg in "$@"; do
    if [ "$arg" != "auth" ] && [ "$arg" != "login" ]; then
        CLEAN_ARGS+=("$arg")
    fi
done

KEY_HASH="7407b4ddbbd1bfbf2dce30edc9115b02dd294ffb233a1e05d28b98df241bc386.key"
KEYRING_GLOBAL="$HOME/.gemini/.keyring"
KEY_FILE_GLOBAL="$KEYRING_GLOBAL/$KEY_HASH"
mkdir -p "$KEYRING_GLOBAL"

get_token_from_dir() {
    local dir="$1"
    local tok=""
    local kfile="$dir/.keyring/$KEY_HASH"
    
    if [ -f "$kfile" ]; then
        tok="$(sed -n '2p' "$kfile" | tr -d '\r\n')"
    fi
    if [ -z "$tok" ] && [ -f "$dir/keyring_token.txt" ]; then
        tok="$(cat "$dir/keyring_token.txt" | tr -d '\r\n')"
    fi
    if [ -z "$tok" ] && [ -f "$dir/antigravity-cli/antigravity-oauth-token" ]; then
        tok="$(cat "$dir/antigravity-cli/antigravity-oauth-token" | tr -d '\r\n')"
    fi
    if [ -z "$tok" ] && [ -f "$dir/antigravity-oauth-token" ]; then
        tok="$(cat "$dir/antigravity-oauth-token" | tr -d '\r\n')"
    fi
    echo "$tok"
}

save_token_to_context() {
    local dir="$1"
    local tok="$2"
    if [ -z "$tok" ]; then return; fi

    mkdir -p "$dir/.keyring" "$dir/antigravity-cli"
    echo -e "gemini:antigravity\n$tok" > "$dir/.keyring/$KEY_HASH"
    echo "$tok" > "$dir/keyring_token.txt"
    echo "$tok" > "$dir/antigravity-cli/antigravity-oauth-token"
    echo "$tok" > "$dir/antigravity-oauth-token"
    echo -e "gemini:antigravity\n$tok" > "$KEY_FILE_GLOBAL"
}

TOKEN="$(get_token_from_dir "$GEMINI_HOME")"

if [ -n "$TOKEN" ]; then
    save_token_to_context "$GEMINI_HOME" "$TOKEN"
    echo -e "\033[36m[agyx]\033[0m Isolated context for account '\033[32m$TARGET_ACC\033[0m': \033[32m$GEMINI_HOME\033[0m (\033[32m✔ Logged In\033[0m)" >&2
else
    rm -f "$KEY_FILE_GLOBAL" 2>/dev/null || true
    rm -f "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
    rm -f "$HOME/.gemini/antigravity-oauth-token" 2>/dev/null || true
    if command -v cmdkey.exe >/dev/null 2>&1; then
        cmdkey.exe /delete:gemini:antigravity >/dev/null 2>&1 || true
        cmdkey.exe /delete:LegacyGeneric:target=gemini:antigravity >/dev/null 2>&1 || true
    fi
    echo -e "\033[36m[agyx]\033[0m Isolated context for account '\033[33m$TARGET_ACC\033[0m': \033[33m$GEMINI_HOME\033[0m (\033[31m✘ Logged Out - Login Required\033[0m)" >&2
fi

echo "$TARGET_ACC" > "$HOME/.gemini/active_account.txt"

# Run agy binary
"$AGY_BIN" "${CLEAN_ARGS[@]}" || true

# Post-run token capture hook: if user logged in during session, persist token for this account
POST_TOKEN="$(get_token_from_dir "$GEMINI_HOME")"
if [ -z "$POST_TOKEN" ] && [ -f "$KEY_FILE_GLOBAL" ]; then
    POST_TOKEN="$(sed -n '2p' "$KEY_FILE_GLOBAL" | tr -d '\r\n')"
fi

if [ -n "$POST_TOKEN" ]; then
    save_token_to_context "$GEMINI_HOME" "$POST_TOKEN"
    echo -e "\033[36m[agyx]\033[0m Persisted session token for account '\033[32m$TARGET_ACC\033[0m'." >&2
fi
