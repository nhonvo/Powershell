{
  // Shell environment settings loaded by Microsoft.PowerShell_profile.ps1 at startup
  "Environment": {
    "PoshThemesPath": "psapp/asset/powershell-themes",
    "PsModulePath": "psapp/Modules",
    "EnableFastStartup": false,
    "ForceLoadRedirected": false,
    "Theme": "neko"
  },
  "Proxy": {
    "HttpProxy": "",
    "HttpsProxy": "",
    "NoProxy": ""
  },
  "Ui": {
    "Mode": "flat-tree",
    "Density": "compact",
    "ActiveTheme": "neko",
    "EnableMobile": false,
    "FavoriteAliases": [
      "proj",
      "agyswitch",
      "ide",
      "claude",
      "theme",
      "learn",
      "obsidian",
      "ssh-info"
    ]
  },
  "Ai": {
    "Mode": "auto",
    "ProviderMode": "ollama",
    "EnableOllama": true,
    "EnableAgy": true
  },
  "Project": {
    "BaseDir": "",
    "SearchPaths": [],
    "ExcludeFolders": []
  },
  "System": {
    "VerboseStartup": false,
    "StartupLogFile": "",
    "PoshThemesPath": "",
    "AgySourceHome": "",
    "GlobalBinDir": ""
  },
  "Obsidian": {
    "VaultPath": ""
  }
}